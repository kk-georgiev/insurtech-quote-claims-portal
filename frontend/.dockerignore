# Mirrors the frontend-relevant entries in the root .gitignore - keeps the
# build context small and avoids leaking local build artifacts/IDE files
# into the image layer cache.

node_modules/
dist/
dist-ssr/
*.local
*.tsbuildinfo
npm-debug.log*

.git/
.gitignore

.idea/
*.iml
.vscode/

.env
.env.*
!.env.example
