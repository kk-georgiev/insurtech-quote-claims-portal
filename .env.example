# Copy this file to `.env` and adjust values for your machine. `.env` is
# gitignored — never commit real secrets (NFR-2). No value below is a real
# credential; they are placeholders / insecure local-dev defaults only.

# --- PostgreSQL (docker-compose.yml `postgres` service + backend datasource) ---
POSTGRES_DB=motorinsurance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host-mapped port for the Postgres container (used by both docker-compose.yml
# and the backend's JDBC URL when running natively against it).
POSTGRES_PORT=5432
# Only needed if the backend connects to Postgres somewhere other than
# localhost (e.g. a remote/dockerized DB host).
POSTGRES_HOST=localhost

# --- Backend (Spring Boot) ---
# Symmetric HMAC signing secret for JWTs (AD-11). Read by auth/application/JwtService.java
# to sign (Story 1.3) login tokens - must be at least 32 bytes (HS256 requires
# a >=256-bit key). If unset, application.yml falls back to an insecure,
# clearly-labeled dev-only default so the backend still starts on a clean
# checkout; never rely on that default outside local dev. Generate a long
# random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-never-commit-a-real-one

# --- Frontend (Vite) ---
# Backend origin the browser can reach. Never hardcoded in frontend code
# (AD-9/AD-10) — always read from this variable.
VITE_API_URL=http://localhost:8080

# --- docker-compose.yml one-command full-stack startup (Story 4.2) ---
# Host-mapped ports for the containerized backend/frontend services. Only
# used by `docker compose up`; irrelevant to native dev. BACKEND_PORT should
# match the port in VITE_API_URL above so the browser-served frontend can
# reach the backend.
BACKEND_PORT=8080
FRONTEND_PORT=5173
