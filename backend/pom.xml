<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.motorinsurance</groupId>
  <artifactId>backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>backend</name>
  <description>Motor Insurance Quote &amp; Claims Portal - backend (modular monolith)</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Full Spring Security starter (Story 1.4, AD-2/AD-3/AD-4): brings the
         filter/context/method-security machinery for the shared JWT
         authentication filter and @PreAuthorize checks. Transitively
         includes spring-security-crypto, so the standalone dependency
         Story 1.2 added just for BCrypt (before this story wired up the real
         filter chain) is redundant now and has been removed. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- JJWT (Story 1.3, AD-11) - issues/parses HS256-signed JWTs. api is
         compile-time only; impl + jackson (for claims (de)serialization) are
         runtime-only, per the library's documented usage pattern. -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.13.0</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.13.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.13.0</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- springdoc-openapi (Story 9.1, FR-M3-14) - generates the OpenAPI 3
         document and Swagger UI from the existing Spring MVC controllers/DTOs
         with zero controller changes. Pinned explicitly, same as jjwt-* above:
         3.1.0 is not in the Spring Boot 4.1.1 BOM, and its release notes
         state it targets Spring Boot 4.1.0 - this project's 4.1.1 is a patch
         release in the same minor line, so compatibility holds. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>3.1.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers (Story 1.5): pricing's repository tests run real
         queries (range lookups, CHECK constraints, the Flyway migrations
         themselves) against a throwaway Postgres container rather than H2,
         per business analysis §16.4 - no separate H2-compatibility variant
         of the schema to maintain. Versions come from spring-boot-dependencies
         (the starter-parent's BOM), same as every other dependency here. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers 2.x (pulled in by Spring Boot 4.1.1) renamed every
         module artifact with a "testcontainers-" prefix - the old bare
         "junit-jupiter"/"postgresql" coordinates from Testcontainers 1.x no
         longer exist. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
