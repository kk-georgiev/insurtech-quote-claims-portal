# Copy this file to `.env` and adjust values for your machine. `.env` is
# gitignored — never commit real secrets (NFR-2). No value below is a real
# credential; they are placeholders / insecure local-dev defaults only.

# --- PostgreSQL (docker-compose.yml `postgres` service + backend datasource) ---
POSTGRES_DB=motorinsurance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host-mapped port for the Postgres container (used by both docker-compose.yml
# and the backend's JDBC URL when running natively against it).
POSTGRES_PORT=5432
# Only needed if the backend connects to Postgres somewhere other than
# localhost (e.g. a remote/dockerized DB host).
POSTGRES_HOST=localhost

# --- Backend (Spring Boot) ---
# Symmetric HMAC signing secret for JWTs (AD-11). Not read by any code yet
# this story (no auth module / JWT filter exists until Story 1.3+) but must
# be documented up front per AD-11. Generate a long random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-never-commit-a-real-one

# --- Frontend (Vite) ---
# Backend origin the browser can reach. Never hardcoded in frontend code
# (AD-9/AD-10) — always read from this variable.
VITE_API_URL=http://localhost:8080
